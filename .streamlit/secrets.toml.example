# .streamlit/secrets.toml
# Streamlit Cloud Secrets Configuration for CyberGuard AI

# Supabase Postgres Database Connection String (Optional — defaults to local SQLite if omitted)
# DATABASE_URL = "postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Local SQLite Database Path (Fallback when DATABASE_URL is not set)
DATABASE_PATH = "data/cyberbullying.db"

# Configurable Admin Account Credentials
ADMIN_EMAIL = "your_admin_email_here"
ADMIN_USERNAME = "your_admin_username_here"
ADMIN_PASSWORD = "your_admin_password_here"

# Anthropic Claude API Key (Required for LLM Reasoning Agent step 5 & 7)
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"

# Google Gemini API Key (Fallback for LLM Reasoning Agent)
GEMINI_API_KEY = "your_gemini_api_key_here"

# Signal Layer Thresholds (0.0 to 1.0)
TOXICITY_THRESHOLD = "0.50"
EMOTION_THRESHOLD = "0.30"
