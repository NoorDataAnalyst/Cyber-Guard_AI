# Streamlit Cloud Secrets Manager Configuration Template (.streamlit/secrets.toml)

# Supabase Managed Postgres Database URI
DATABASE_URL = "postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Admin Dashboard Access Gate Password
ADMIN_PASSWORD = "your_admin_password_here"

# Anthropic Claude API Key
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"

# Optional Google Gemini API Key
GEMINI_API_KEY = "your_gemini_api_key_here"
