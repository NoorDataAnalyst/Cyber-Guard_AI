# Supabase Postgres Database Connection String
# Obtain from Supabase Console -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Admin Dashboard Password (Gate protection)
ADMIN_PASSWORD=your_admin_password_here

# Anthropic Claude API Key (Required for LLM Reasoning Agent step 5 & 7)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google Gemini API Key fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Toxicity Signal Threshold (0.0 to 1.0)
TOXICITY_THRESHOLD=0.50
